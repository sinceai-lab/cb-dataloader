{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$schemaVersion": "1.0.0",
  "$id": "urn:apetit-sinceai2026:schema:WaterBalance",
  "title": "Apetit Climate & Nature Navigator - WaterBalance",
  "description": "Annual water withdrawals and discharges by source/destination.",
  "type": "object",
  "x-source-format": "csv",
  "x-stage": "bronze",
  "x-primary-key": [
    "site_id",
    "year",
    "flow",
    "source_or_destination"
  ],
  "properties": {
    "site_id": {
      "type": "string",
      "description": "Site",
      "x-observed-values": [
        "S-BJU",
        "S-HQ",
        "S-KAN",
        "S-PUD",
        "S-SAK"
      ],
      "x-term": "site_id"
    },
    "year": {
      "type": "integer",
      "description": "Year",
      "x-observed-min": 2019,
      "x-observed-max": 2025,
      "x-term": "year"
    },
    "flow": {
      "type": "string",
      "description": "withdrawal / discharge",
      "x-observed-values": [
        "discharge",
        "withdrawal"
      ],
      "x-term": "water_flow"
    },
    "source_or_destination": {
      "type": "string",
      "description": "Source or destination",
      "x-observed-values": [
        "lake_water",
        "municipal_sewer",
        "own_wastewater_treatment_plant",
        "rain_water",
        "reused_water",
        "runoff",
        "sea",
        "sea_water",
        "third_party_municipal"
      ],
      "x-term": "source_or_destination"
    },
    "m3": {
      "type": "integer",
      "description": "m3",
      "x-observed-min": 889,
      "x-observed-max": 545004,
      "x-term": "water_m3",
      "x-unit-code": "MTQ"
    }
  },
  "required": [
    "site_id",
    "year",
    "flow",
    "source_or_destination",
    "m3"
  ],
  "additionalProperties": false,
  "x-data-quality": "Raw feed: planted data-quality issues by design (see TASKS_AND_SCORING.md A1). Do not enforce value ranges; use x-observed-* only as a hint.",
  "x-observation": {
    "subject": {
      "column": "site_id",
      "type": "Site"
    },
    "time": {
      "year": "year"
    },
    "dimensions": [
      "flow",
      "source_or_destination"
    ]
  }
}