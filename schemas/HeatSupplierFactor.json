{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$schemaVersion": "1.0.0",
  "$id": "urn:apetit-sinceai2026:schema:HeatSupplierFactor",
  "title": "Apetit Climate & Nature Navigator - HeatSupplierFactor",
  "description": "Supplier-specific emission factors for purchased steam / district heat.",
  "type": "object",
  "x-source-format": "csv",
  "x-stage": "bronze",
  "x-primary-key": [
    "site_id",
    "year"
  ],
  "properties": {
    "site_id": {
      "type": "string",
      "description": "Site",
      "x-term": "site_id"
    },
    "year": {
      "type": "integer",
      "description": "Year",
      "x-observed-min": 2019,
      "x-observed-max": 2023,
      "x-term": "year"
    },
    "supplier": {
      "type": "string",
      "description": "Supplier",
      "x-term": "heat_supplier"
    },
    "t_per_mwh": {
      "type": "number",
      "description": "t CO2e per MWh",
      "x-observed-min": 0.1,
      "x-observed-max": 0.33,
      "x-term": "tco2e_per_mwh",
      "x-unit-text": "tCO2e/MWh"
    }
  },
  "required": [
    "site_id",
    "year",
    "supplier",
    "t_per_mwh"
  ],
  "additionalProperties": false,
  "x-data-quality": "Raw feed: planted data-quality issues by design (see TASKS_AND_SCORING.md A1). Do not enforce value ranges; use x-observed-* only as a hint.",
  "x-observation": {
    "subject": {
      "column": "site_id",
      "type": "Site"
    },
    "time": {
      "year": "year"
    }
  }
}