{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$schemaVersion": "1.0.0",
  "$id": "urn:apetit-sinceai2026:schema:ClimateChangeSignal",
  "title": "Apetit Climate & Nature Navigator - ClimateChangeSignal",
  "description": "Monthly change signals 2041-2060 vs 1991-2020 by SSP.",
  "type": "object",
  "x-source-format": "csv",
  "x-stage": "reference",
  "x-primary-key": [
    "scenario",
    "month"
  ],
  "properties": {
    "scenario": {
      "type": "string",
      "description": "SSP",
      "x-term": "ssp_scenario"
    },
    "period": {
      "type": "string",
      "description": "Period",
      "x-term": "climate_period"
    },
    "month": {
      "type": "integer",
      "description": "Month",
      "x-observed-min": 1,
      "x-observed-max": 12,
      "x-term": "month"
    },
    "delta_tmean_c": {
      "type": "number",
      "description": "Temperature change (C)",
      "x-unit": "Cel",
      "x-observed-min": 1.3,
      "x-observed-max": 3.9,
      "x-term": "delta_tmean_c",
      "x-unit-code": "CEL"
    },
    "precip_factor": {
      "type": "number",
      "description": "Precipitation amount factor",
      "x-observed-min": 1.03,
      "x-observed-max": 1.17,
      "x-term": "precip_factor"
    },
    "wetday_factor": {
      "type": "number",
      "description": "Wet-day frequency factor",
      "x-observed-min": 0.95,
      "x-observed-max": 1.05,
      "x-term": "wetday_factor"
    }
  },
  "required": [
    "scenario",
    "period",
    "month",
    "delta_tmean_c",
    "precip_factor",
    "wetday_factor"
  ],
  "additionalProperties": false
}