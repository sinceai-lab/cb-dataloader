{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$schemaVersion": "1.0.0",
  "$id": "urn:apetit-sinceai2026:schema:CapexProject",
  "title": "Apetit Climate & Nature Navigator - CapexProject",
  "description": "Capital projects.",
  "type": "object",
  "x-source-format": "csv",
  "x-stage": "bronze",
  "x-primary-key": [
    "year",
    "site_id",
    "project"
  ],
  "properties": {
    "year": {
      "type": "integer",
      "description": "Year",
      "x-observed-min": 2019,
      "x-observed-max": 2025,
      "x-term": "year"
    },
    "site_id": {
      "type": "string",
      "description": "Site",
      "x-term": "site_id"
    },
    "project": {
      "type": "string",
      "description": "Project",
      "x-term": "project"
    },
    "capex_type": {
      "type": "string",
      "description": "machinery / construction",
      "x-term": "capex_type"
    },
    "capex_eur": {
      "type": "number",
      "description": "EUR",
      "x-observed-min": 910687.89994416,
      "x-observed-max": 6500000.0,
      "x-term": "capex_eur",
      "x-unit-text": "EUR"
    }
  },
  "required": [
    "year",
    "site_id",
    "project",
    "capex_type",
    "capex_eur"
  ],
  "additionalProperties": false,
  "x-data-quality": "Raw feed: planted data-quality issues by design (see TASKS_AND_SCORING.md A1). Do not enforce value ranges; use x-observed-* only as a hint.",
  "x-observation": {
    "subject": {
      "column": "site_id",
      "type": "Site"
    },
    "time": {
      "year": "year"
    },
    "dimensions": [
      "project"
    ]
  }
}