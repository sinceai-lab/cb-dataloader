# MCP Server variables
MCP_SERVER_PORT=3003

# Chat-bot variables
CHAT_BOT_PORT=3006
SESSION_SECRET=change-me-in-production

# Keycloak variables
KEYCLOAK_PORT=3005

# OAuth variables
OIDC_REALM=farm-management
OIDC_CLIENT_ID=ngsi-ld-farm
OIDC_CLIENT_SECRET=1234
MCP_CLIENT_ID=ngsi-ld-mcp-server
MCP_CLIENT_SECRET=1234

# Chat-bot LLM providers: fill in only the keys you use.
# A provider is enabled when its API key (or, for Ollama, its base URL) is set.
# Supported: anthropic, openai, gemini, groq, openrouter, nvidia, cohere, ollama.
# 
# Run ./check-models to verify keys and see which model each provider would use.
CHAT_BOT_PROVIDER=gemini
# Anthropic key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=
# OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
# Ollama runs on the host (memory intensive).
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5:3b
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=models/gemini-3.5-flash

# Groq key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=

# OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# NVIDIA NIM key: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=

# Cohere key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1
COHERE_MODEL=
